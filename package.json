{
  "name": "spanios-wiki",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm --filter spanios-wiki-fe build",
    "check": "pnpm --filter spanios-wiki-fe check",
    "dev": "pnpm --filter spanios-wiki-fe dev",
    "format": "pnpm --filter spanios-wiki-fe format",
    "lint": "pnpm --filter spanios-wiki-fe lint",
    "start": "pnpm --filter spanios-wiki-fe start",
    "test": "pnpm --filter spanios-wiki-fe test",
    "typecheck": "pnpm --filter spanios-wiki-fe exec tsc --noEmit"
  }
}
