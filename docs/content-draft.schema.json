{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanios.wiki/schemas/content-draft.schema.json",
  "title": "Spanios Disease Content Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "locale",
    "review",
    "updatedReason",
    "sources",
    "article"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "locale": {
      "type": "string",
      "enum": ["zh", "en", "zh-Hant"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "createdBy", "createdAt"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending-codex-review",
            "merged",
            "rejected",
            "needs-revision"
          ]
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "riskNotes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reviewedBy": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "decisionNotes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "updatedReason": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "type": {
            "type": "string",
            "enum": [
              "clinical-guideline",
              "official",
              "patient-organization",
              "policy",
              "review",
              "wikipedia-entry",
              "wikipedia-template"
            ]
          },
          "license": { "type": "string" }
        }
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oneSentence", "quickLook", "patientJourney"],
      "properties": {
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "alias": { "type": "string" },
        "plainName": { "type": "string" },
        "oneSentence": { "type": "string", "minLength": 1 },
        "prevalence": { "type": "string" },
        "quickLook": {
          "type": "object",
          "additionalProperties": false,
          "required": ["whatItIs", "whoToSeeFirst"],
          "properties": {
            "whatItIs": { "type": "string", "minLength": 1 },
            "whoToSeeFirst": { "type": "string", "minLength": 1 },
            "isGenetic": { "type": "string" },
            "hasTreatment": { "type": "string" },
            "commonDelayReason": { "type": "string" }
          }
        },
        "patientJourney": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "whenToSuspect": { "$ref": "#/$defs/stringList" },
            "commonWrongTurns": { "$ref": "#/$defs/stringList" },
            "firstDepartments": { "$ref": "#/$defs/stringList" },
            "diagnosisChecklist": { "$ref": "#/$defs/stringList" },
            "testsToAskAbout": { "$ref": "#/$defs/stringList" },
            "questionsForDoctor": { "$ref": "#/$defs/stringList" }
          }
        },
        "medicalSections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "symptoms": { "type": "string" },
            "diagnosis": { "type": "string" },
            "treatment": { "type": "string" },
            "longTermCare": { "type": "string" },
            "fertilityOrFamily": { "type": "string" },
            "emergencySigns": { "type": "string" }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "prompt"],
          "properties": {
            "path": { "type": "string" },
            "prompt": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
