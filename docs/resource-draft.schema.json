{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanios.wiki/schemas/resource-draft.schema.json",
  "title": "Spanios Resource Relationship Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale", "review", "relationships"],
  "properties": {
    "locale": {
      "type": "string",
      "enum": ["zh", "en", "zh-Hant"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "createdBy", "createdAt"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending-codex-review",
            "merged",
            "rejected",
            "needs-revision"
          ]
        },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "decisionNotes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resourceType",
          "name",
          "officialUrl",
          "evidenceUrl",
          "evidenceSummary",
          "relationKind",
          "diseaseSlugs",
          "confidence"
        ],
        "properties": {
          "resourceType": {
            "type": "string",
            "enum": ["hospital", "charity"]
          },
          "name": { "type": "string", "minLength": 1 },
          "officialUrl": { "type": "string", "format": "uri" },
          "evidenceUrl": { "type": "string", "format": "uri" },
          "evidenceSummary": { "type": "string", "minLength": 1 },
          "relationKind": {
            "type": "string",
            "enum": [
              "rare-disease-network",
              "department-service",
              "clinic-or-mdt",
              "patient-organization-focus",
              "assistance-program",
              "public-directory"
            ]
          },
          "diseaseSlugs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "departmentName": { "type": "string" },
          "serviceName": { "type": "string" },
          "province": { "type": "string" },
          "city": { "type": "string" },
          "contactUrl": { "type": "string", "format": "uri" },
          "notes": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        }
      }
    }
  }
}
