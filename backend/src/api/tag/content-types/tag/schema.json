{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "Tag",
    "description": "标签"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["symptom", "treatment", "organ_system", "other"],
      "required": true
    },
    "diseases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::disease.disease",
      "mappedBy": "tags"
    }
  }
}
