{
  "kind": "collectionType",
  "collectionName": "diseases",
  "info": {
    "singularName": "disease",
    "pluralName": "diseases",
    "displayName": "Disease",
    "description": "罕见病"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "nameEn": {
      "type": "string"
    },
    "alias": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "icd10Code": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "prevalence": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "symptoms": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "diagnosis": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "treatment": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "prognosis": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::disease-category.disease-category",
      "inversedBy": "diseases"
    },
    "relatedDiseases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::disease.disease"
    },
    "hospitals": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::hospital.hospital",
      "inversedBy": "diseases"
    },
    "charityOrgs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::charity-organization.charity-organization",
      "inversedBy": "diseases"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "diseases"
    }
  }
}
