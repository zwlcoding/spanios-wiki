{
  "kind": "collectionType",
  "collectionName": "disease_categories",
  "info": {
    "singularName": "disease-category",
    "pluralName": "disease-categories",
    "displayName": "DiseaseCategory",
    "description": "疾病分类"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "parentCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::disease-category.disease-category",
      "inversedBy": "childCategories"
    },
    "childCategories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::disease-category.disease-category",
      "mappedBy": "parentCategory"
    },
    "icon": {
      "type": "string",
      "default": "📋"
    },
    "diseases": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::disease.disease",
      "mappedBy": "category"
    }
  }
}
