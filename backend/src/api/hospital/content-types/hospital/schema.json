{
  "kind": "collectionType",
  "collectionName": "hospitals",
  "info": {
    "singularName": "hospital",
    "pluralName": "hospitals",
    "displayName": "Hospital",
    "description": "医院"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "level": {
      "type": "enumeration",
      "enum": ["tertiary_a", "tertiary_b", "secondary_a", "secondary_b"]
    },
    "province": {
      "type": "string",
      "required": true
    },
    "city": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "specialties": {
      "type": "richtext"
    },
    "location": {
      "type": "json"
    },
    "departments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::department.department",
      "mappedBy": "hospital"
    },
    "diseases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::disease.disease",
      "mappedBy": "hospitals"
    }
  }
}
